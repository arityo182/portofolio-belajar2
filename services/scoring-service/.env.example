# ============================================================================
# Scoring Service — local development environment
# Copy to .env for local runs. Compose passes these variables explicitly.
# ============================================================================

SERVICE_NAME=scoring-service
SERVICE_VERSION=1.0.0
APP_ENV=local
LOG_LEVEL=INFO
SERVER_PORT=8083
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://localhost

# Model artifacts (relative to the service working directory)
ML_MODEL_PATH=models/credit_model_v1.0.0.h5
ML_SCALER_PATH=models/scaler.pkl
ML_ENCODER_PATH=models/encoder.pkl
ML_METADATA_PATH=models/model_metadata.json
MODEL_VERSION=v1.0.0
MODEL_TRAINED_AT=2026-10-01T00:00:00Z
MODEL_METRICS={"auc_roc":0.83,"precision_approve":0.87,"recall_reject":0.78,"gini":0.66,"ks":0.44}
CANARY_TRAFFIC_PCT=0

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=koperasi
DB_USER=scoring_user
DB_PASSWORD=scoreP@ss
DB_SCHEMA=scoring_schema
DB_CONNECT_ON_STARTUP=false
DB_CONNECT_RETRIES=10
DB_CONNECT_RETRY_DELAY_SECONDS=2
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
DB_COMMAND_TIMEOUT_SECONDS=5
# DB_DSN=postgresql://scoring_user:scoreP%40ss@localhost:5432/koperasi

# Kafka (trigger: loan.scoring.requested)
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID=scoring-service-group
KAFKA_TOPIC_SCORING_REQUESTED=loan.scoring.requested
KAFKA_TOPIC_SCORING_COMPLETED=loan.scoring.completed
KAFKA_AUTO_OFFSET_RESET=earliest

# HTTP callback to loan-service (best effort; Kafka result is authoritative)
LOAN_SERVICE_URL=http://localhost:8082
SCORING_CALLBACK_PATH=/api/v1/loans/internal/scoring/completed
CALLBACK_ENABLED=false
CALLBACK_TIMEOUT_SECONDS=5
CALLBACK_MAX_RETRIES=2
INTERNAL_CALLBACK_TOKEN=local-internal-callback-token

# ============================================================================
# Koperasi Digital — Environment Variables (LOCAL DEVELOPMENT TEMPLATE)
# Copy to .env before running: cp .env.example .env
# NEVER commit .env. Rotate all credentials before any shared/production use.
# ============================================================================

# ---------------------------------------------------------------------------
# Common
# ---------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=docker
TZ=Asia/Jakarta
LOG_LEVEL=INFO
LOG_LEVEL_APP=INFO
LOG_LEVEL_SECURITY=WARN
LOG_LEVEL_SQL=WARN
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,prometheus,metrics
MANAGEMENT_ENDPOINT_HEALTH_PROBES_ENABLED=true
SHUTDOWN_TIMEOUT=30s

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_DB=koperasi
POSTGRES_USER=koperasi
POSTGRES_PASSWORD=koperasi
POSTGRES_PORT=5432

AUTH_DB_PASSWORD=authP@ss
LOAN_DB_PASSWORD=loanP@ss
SCORING_DB_PASSWORD=scoreP@ss
PAYMENT_DB_PASSWORD=payP@ss
NOTIF_DB_PASSWORD=notifP@ss
REPORT_DB_PASSWORD=reportP@ss
INVESTOR_DB_PASSWORD=investorP@ss
# NOTE: init-db.sql seeds these same local passwords. If you change them here,
# update init-db.sql before the first `docker compose up` (or rotate the roles
# manually with ALTER ROLE).

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=s3cr3t
REDIS_DATABASE=0
REDIS_TIMEOUT=2s
REDIS_POOL_MAX_ACTIVE=16
REDIS_POOL_MAX_IDLE=8
REDIS_POOL_MIN_IDLE=2
REDIS_POOL_MAX_WAIT=2s

# ---------------------------------------------------------------------------
# Kafka / ZooKeeper
# ---------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_PORT=29092
KAFKA_AUDIT_TOPIC=audit.event.created
AUDIT_KAFKA_ENABLED=true
KAFKA_PRODUCER_ACKS=all
KAFKA_PRODUCER_RETRIES=3
KAFKA_PRODUCER_IDEMPOTENCE=true
KAFKA_PRODUCER_DELIVERY_TIMEOUT_MS=120000
KAFKA_PRODUCER_REQUEST_TIMEOUT_MS=30000
KAFKA_CONSUMER_GROUP=loan-service-group

# ---------------------------------------------------------------------------
# RabbitMQ
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# JWT / Security
# ---------------------------------------------------------------------------
# Required. Generate with: openssl rand -base64 48
# Minimum 32 bytes. Prefix with "base64:" to provide a Base64-encoded key.
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_48
# AES-256 key for NIK/NPWP/bank account encryption (base64, 32 bytes).
PII_ENCRYPTION_KEY=base64:CHANGE_ME_generate_with_openssl_rand_base64_32
PASSWORD_RESET_LOG_LINK=true
PASSWORD_RESET_URL=https://localhost/reset-password
JWT_ISSUER=koperasi-auth
JWT_ACCESS_TOKEN_TTL=900
JWT_REFRESH_TOKEN_TTL=604800
BCRYPT_COST_FACTOR=12
CORS_ALLOWED_ORIGINS=https://localhost
WEBSOCKET_ALLOWED_ORIGINS=https://localhost
RATE_LIMIT_DEFAULT_RPM=100

# ---------------------------------------------------------------------------
# Service ports / routing
# ---------------------------------------------------------------------------
SERVER_PORT=8081
AUTH_PORT=8081
LOAN_PORT=8082
SCORING_PORT=8083
PAYMENT_PORT=8084
FRONTEND_PORT=3000
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443


SCORING_SERVICE_URL=http://scoring-service:8083
PAYMENT_SERVICE_URL=http://payment-service:8084
LOAN_SERVICE_URL=http://loan-service:8082
LOAN_DEFAULT_OVERDUE_DAYS=90

# ---------------------------------------------------------------------------
# Payment gateways (sandbox placeholders — replace with real sandbox keys)
# ---------------------------------------------------------------------------
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxx
MIDTRANS_WEBHOOK_SECRET=change-me
MIDTRANS_IS_PRODUCTION=false
XENDIT_API_KEY=xnd_development_xxxxxxxxxxxxxxxx
XENDIT_WEBHOOK_TOKEN=change-me
IDEMPOTENCY_TTL_HOURS=24
PAYMENT_LOCK_TTL_SECONDS=15
PAYMENT_RETRY_MAX_ATTEMPTS=3
PAYMENT_RETRY_BASE_BACKOFF_MS=1000
MIDTRANS_SNAP_BASE_URL=https://app.sandbox.midtrans.com
MIDTRANS_API_BASE_URL=https://api.sandbox.midtrans.com
MIDTRANS_BENEFICIARY_NAME=Koperasi Digital
MIDTRANS_BENEFICIARY_ACCOUNT=0000000000
MIDTRANS_BENEFICIARY_BANK=BCA
XENDIT_BASE_URL=https://api.xendit.co
XENDIT_BANK_CODE=BCA
XENDIT_ACCOUNT_HOLDER_NAME=Koperasi Digital
XENDIT_ACCOUNT_NUMBER=0000000000

# ---------------------------------------------------------------------------
# Notification / SMTP
# ---------------------------------------------------------------------------
SMTP_HOST=email-smtp.ap-southeast-1.amazonaws.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
KAFKA_LISTENER_AUTO_STARTUP=true
NOTIFICATION_REDIS_FANOUT=true
NOTIFICATION_FANOUT_CHANNEL=notifications:fanout
NOTIFICATION_SSE_HEARTBEAT_MS=30000
NOTIFICATION_SSE_TIMEOUT_MS=1800000
NOTIFICATION_MAX_PAGE_SIZE=100

# ---------------------------------------------------------------------------
# AI / ML scoring
# ---------------------------------------------------------------------------
ML_MODEL_PATH=/app/models/credit_model_v1.0.0.h5
ML_SCALER_PATH=/app/models/scaler.pkl
ML_ENCODER_PATH=/app/models/encoder.pkl
ML_METADATA_PATH=/app/models/model_metadata.json
MODEL_VERSION=v1.0.0
MODEL_TRAINED_AT=2026-10-01T00:00:00Z
CANARY_TRAFFIC_PCT=0

# Scoring service (Kafka trigger + callback to loan-service)
SCORING_KAFKA_ENABLED=true
SCORING_CALLBACK_ENABLED=true
CALLBACK_TIMEOUT_SECONDS=5
CALLBACK_MAX_RETRIES=2
# Required. Generate with: openssl rand -hex 32
INTERNAL_CALLBACK_TOKEN=CHANGE_ME_generate_with_openssl_rand_hex_32
DB_CONNECT_RETRIES=10
DB_CONNECT_RETRY_DELAY_SECONDS=2

# ---------------------------------------------------------------------------
# Reporting
# ---------------------------------------------------------------------------
REPORT_EXPORT_BUCKET=koperasi-reports

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=https://localhost/api/v1
NEXT_PUBLIC_WS_URL=wss://localhost/ws
NEXT_PUBLIC_APP_URL=https://localhost
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxx
NEXT_PUBLIC_ENV=local
NEXT_PUBLIC_LOAN_INSTALLMENT_METHOD=FLAT

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_ROOT_URL=http://localhost:3001
